# QR linklerinin işaret ettiği ana site
NEXT_PUBLIC_QR_BASE_URL=https://www.theyine.com

# Bu subapp'in kendi public URL'i (QR kodların içine yazılır, embed snippet'lerde kullanılır)
NEXT_PUBLIC_APP_URL=https://enterprise-qr.theyine.vercel.app

# JWT imzalama anahtarı — production'da mutlaka değiştir (min 32 karakter rastgele)
QR_SIGNING_SECRET=REPLACE_ME

# Landing'deki demo video (YouTube linki veya .mp4 URL'i) — boşsa placeholder gösterilir
NEXT_PUBLIC_DEMO_VIDEO_URL=

# İleride ödeme entegrasyonu için (şimdilik kullanılmıyor)
STRIPE_KEY=REPLACE_ME

# SMS / WhatsApp rezervasyon onayı için (şimdilik kullanılmıyor)
TWILIO_SID=REPLACE_ME
TWILIO_TOKEN=REPLACE_ME
