# Copy to .env.local for local dev, or set these in your hosting dashboard.

# Google Analytics 4 measurement id.
# If unset (or empty) the code falls back to the id baked into lib/analytics.ts.
NEXT_PUBLIC_GA_ID=

# Demo walkthrough video on /enterprise-tryon.
# Paste a normal YouTube or Vimeo share link — the component converts it to an
# embed URL itself. Leave empty to keep the "coming soon" poster.
# Examples:
#   https://www.youtube.com/watch?v=XXXXXXXXXXX
#   https://youtu.be/XXXXXXXXXXX
#   https://vimeo.com/123456789
NEXT_PUBLIC_DEMO_VIDEO_URL=

# Origin of the QR subapp serving /embed.js (components/QRWidget.tsx).
# Temporary Vercel URL until qr.theyine.com is attached; then switch and redeploy.
#   https://theyine-tzyj.vercel.app   →   https://qr.theyine.com
NEXT_PUBLIC_QR_WIDGET_ORIGIN=

# Lead Magnet intake (app/api/lead/route.ts) — Dupnitsa AI competitor report.

# Apify — triggers the competitor/content scan. Get the token from
# Apify Console → Settings → Integrations. Set ONE of the two below,
# depending on whether you run a saved Task or an Actor directly.
APIFY_API_TOKEN=
APIFY_TASK_ID=
APIFY_ACTOR_ID=

# SMTP (nodemailer) — sends the customer confirmation + internal lead
# notification email. Leave SMTP_USER/SMTP_PASS empty to simulate sends
# (logs instead of sending) — nothing crashes without them.
# For Gmail: use an App Password (myaccount.google.com/apppasswords), not
# your normal password — regular passwords are rejected by SMTP auth.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional — defaults to SMTP_USER if unset.
SMTP_FROM=

# Where the internal "new lead" notification email is sent.
LEAD_NOTIFICATION_EMAIL=

# Remotion video engine (scripts/generate-video.ts, "npm run generate:video").
# Powers the free-text -> lesson-script LLM step. Get a key from
# console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=

# OpenAI TTS — narrates the generated script (src/remotion/skill/generateNarration.ts).
# Get a key from platform.openai.com/api-keys. This is a separate account/
# billing system from Anthropic — API credits there don't cover this.
OPENAI_API_KEY=
# Optional — one of: alloy, ash, ballad, coral, echo, fable, onyx, nova,
# sage, shimmer, verse. Defaults to "onyx" (confident, energetic).
OPENAI_TTS_VOICE=

# /studio web UI (app/api/generate-video/route.ts) — each generation spends
# real Anthropic + OpenAI credits, so gate it behind a shared code before
# making the site public. Leave empty to allow anyone to generate (fine for
# local dev only; the route logs a warning when this is unset).
STUDIO_ACCESS_CODE=

# BlokMate (app/blokmate/**, app/api/blokmate/**) — apartment/site management
# module. All of these are optional at the code level: lead insert / email /
# payment write each degrade to a logged skip when unconfigured rather than
# failing the request — see lib/blokmate.ts and app/api/blokmate/*/route.ts.

# Supabase project (Project Settings → API). NEXT_PUBLIC_SUPABASE_URL is not
# secret (it's the project's REST endpoint); SUPABASE_SERVICE_ROLE_KEY is —
# it bypasses Row Level Security and must only ever be read server-side
# (already the case in lib/blokmate.ts). Run supabase/migrations/001_init_blokmate.sql
# against this project before the lead API can actually insert anything, and
# add RLS policies (see that file's header comment) before any client-side
# Supabase query touches these tables.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed once BlokMate does client-side (browser) Supabase queries —
# nothing in this codebase reads it yet.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the internal "new BlokMate lead" notification email is sent.
BLOKMATE_NOTIFICATION_EMAIL=

# Composio — NOT currently wired up. lib/blokmate.ts's sendBlokmateEmail()
# uses the SMTP_* vars above (nodemailer) instead: an earlier attempt to use
# @composio/core here failed with a persistent 401 "Invalid API key" that
# blocked the request outright (see app/api/lead/route.ts's git history).
# Leave unset unless/until that's root-caused and a real Composio call
# replaces the SMTP one.
COMPOSIO_API_KEY=

# Payment webhook (app/api/blokmate/payments/route.ts) — currently a
# scaffold with NO real signature verification (see that file's TODO
# comments). Pick one provider before going live; both are listed since
# BlokMate's likely market (Bulgaria/Turkey) makes either plausible.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# Base URL of this deployment — used for building absolute links (e.g. in
# emails) where a relative path won't do.
NEXT_PUBLIC_APP_URL=https://theyine.com

# Optional — error monitoring (Sentry). Not integrated in code yet.
SENTRY_DSN=
